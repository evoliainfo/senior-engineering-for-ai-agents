{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sef.local/schemas/project-state.v1.json",
  "title": "SEF Project State Spine v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_id",
    "revision",
    "delivery_state",
    "updated_at",
    "domains",
    "evidence",
    "transitions",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "sef.project-state.v1"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "revision": {"type": "integer", "minimum": 1},
    "delivery_state": {
      "enum": [
        "FRAMED",
        "ARCHITECTED",
        "IMPLEMENTED",
        "VERIFIED_LOCAL",
        "PREVIEW_VERIFIED",
        "RELEASE_READY",
        "DEPLOYED",
        "POST_DEPLOY_VERIFIED"
      ]
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "domains": {"$ref": "#/$defs/domains"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transition"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "authority", "status", "evidence_refs", "updated_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "kind": {"enum": ["FACT", "DECISION", "ASSUMPTION", "UNRESOLVED"]},
        "statement": {"type": "string", "minLength": 1},
        "authority": {"enum": ["USER", "REPOSITORY", "ENGINEERING", "EXTERNAL", "SYSTEM"]},
        "status": {"enum": ["ACTIVE", "RESOLVED", "SUPERSEDED"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "observed_at", "status", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "kind": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "locator": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["OBSERVED", "INVALIDATED"]},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from_state", "to_state", "at", "evidence_refs", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "kind": {"enum": ["ADVANCE", "REGRESS"]},
        "from_state": {
          "type": ["string", "null"],
          "enum": [null, "FRAMED", "ARCHITECTED", "IMPLEMENTED", "VERIFIED_LOCAL", "PREVIEW_VERIFIED", "RELEASE_READY", "DEPLOYED", "POST_DEPLOY_VERIFIED"]
        },
        "to_state": {
          "enum": ["FRAMED", "ARCHITECTED", "IMPLEMENTED", "VERIFIED_LOCAL", "PREVIEW_VERIFIED", "RELEASE_READY", "DEPLOYED", "POST_DEPLOY_VERIFIED"]
        },
        "at": {"type": "string", "format": "date-time"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "domains": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "requirements",
        "architecture",
        "interfaces",
        "data",
        "identity_access",
        "integrations",
        "environments",
        "quality",
        "security",
        "release",
        "deployments",
        "observability",
        "open_decisions",
        "known_risks"
      ],
      "properties": {
        "product": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "requirements": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "architecture": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "interfaces": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "data": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "identity_access": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "integrations": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "environments": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "quality": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "security": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "release": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "deployments": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "observability": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "open_decisions": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
        "known_risks": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
      }
    }
  }
}
