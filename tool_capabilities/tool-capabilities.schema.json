{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sef.local/schemas/tool-capabilities.schema.json",
  "title": "SEF Tool Capability Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resolved_at", "max_observation_age_seconds", "requirements", "observations"],
  "properties": {
    "schema": {"const": "sef.tool-capability-observations.v1"},
    "resolved_at": {"type": "string", "format": "date-time"},
    "max_observation_age_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "access", "sensitivity", "required_evidence_kinds"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "access": {"enum": ["READ", "WRITE"]},
          "sensitivity": {"enum": ["LOCAL", "SANDBOX", "PRODUCTION_SENSITIVE"]},
          "required_evidence_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "capability", "surface_id", "source_kind", "source_ref", "observed_at",
          "availability", "authentication", "access", "sensitivity", "evidence_kinds",
          "evidence_ref", "authorization_required", "authorization_ref"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
          "surface_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "source_kind": {"enum": ["BUILTIN", "MCP", "FUNCTION", "CLI", "PROJECT"]},
          "source_ref": {"type": "string", "minLength": 1},
          "observed_at": {"type": "string", "format": "date-time"},
          "availability": {"enum": ["AVAILABLE", "UNAVAILABLE", "UNKNOWN"]},
          "authentication": {"enum": ["AUTHENTICATED", "UNAUTHENTICATED", "NOT_APPLICABLE", "UNKNOWN"]},
          "access": {"enum": ["NONE", "READ", "WRITE"]},
          "sensitivity": {"enum": ["LOCAL", "SANDBOX", "PRODUCTION_SENSITIVE"]},
          "evidence_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"}
          },
          "evidence_ref": {"type": ["string", "null"]},
          "authorization_required": {"enum": ["REQUIRED", "NOT_REQUIRED", "UNKNOWN"]},
          "authorization_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
