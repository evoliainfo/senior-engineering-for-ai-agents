{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sef.local/schemas/launch-production-web-product.v1.json",
  "title": "SEF launch-production-web-product mission v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mission_id",
    "project_id",
    "outcome",
    "acceptance",
    "surfaces",
    "expertise_needs",
    "created_at"
  ],
  "properties": {
    "schema": {"const": "sef.delivery-mission.launch-production-web-product.v1"},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "project_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "outcome": {"type": "string", "minLength": 1, "maxLength": 1200},
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "authority", "blocking"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "statement": {"type": "string", "minLength": 1, "maxLength": 1200},
          "authority": {"enum": ["USER", "ENGINEERING"]},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "web_ui",
        "persistent_data",
        "material_data_change",
        "identity_access",
        "billing",
        "external_integrations"
      ],
      "properties": {
        "web_ui": {"const": true},
        "persistent_data": {"type": "boolean"},
        "material_data_change": {"type": "boolean"},
        "identity_access": {"type": "boolean"},
        "billing": {"type": "boolean"},
        "external_integrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": {"type": "string", "minLength": 1, "maxLength": 80},
              "name": {"type": "string", "minLength": 1, "maxLength": 300}
            }
          }
        }
      }
    },
    "expertise_needs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mission_need", "subject", "context_domains"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "mission_need": {"type": "string", "minLength": 1, "maxLength": 800},
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "version_context"],
            "properties": {
              "kind": {"enum": ["EXTERNAL_PROVIDER", "FRAMEWORK", "REPOSITORY_CONTRACT", "STANDARD"]},
              "name": {"type": "string", "minLength": 1, "maxLength": 300},
              "version_context": {"type": ["string", "null"], "maxLength": 200}
            }
          },
          "context_domains": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "product",
                "requirements",
                "architecture",
                "interfaces",
                "data",
                "identity_access",
                "integrations",
                "environments",
                "quality",
                "security",
                "release",
                "deployments",
                "observability",
                "open_decisions",
                "known_risks"
              ]
            }
          }
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
