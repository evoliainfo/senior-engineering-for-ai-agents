{
  "schema": "sef.eval.semantic-v2-s3-controls.v1",
  "purpose": "Deterministic policy-composer acceptance. These controls test relation-to-governance mapping, fail-closed review behavior, idempotence and monotonicity without any live semantic provider.",
  "controls": [
    {"id": "S3-AUTH-DEPARTMENT", "kind": "authorization", "scope_label": "department"},
    {"id": "S3-AUTH-BRANCH", "kind": "authorization", "scope_label": "branch"},
    {"id": "S3-AUTH-REGION", "kind": "authorization", "scope_label": "region"},
    {"id": "S3-AUTH-DIVISION", "kind": "authorization", "scope_label": "division"},
    {"id": "S3-TRUST", "kind": "single_fact", "fact_kind": "SERVER_DESTINATION_TRUST", "risk": "R3", "packs": ["WEBHOOK_TRUST"], "procedures": ["webhook-external-input-trust"]},
    {"id": "S3-SUPPLIER", "kind": "single_fact", "fact_kind": "EXTERNAL_OPERATIONAL_DEPENDENCY", "risk": "R3", "packs": ["EXTERNAL_SUPPLIER"], "procedures": ["external-supplier-saas-governance"]},
    {"id": "S3-REGULATED", "kind": "regulated"},
    {"id": "S3-DATA-COMPOSITION", "kind": "data_composition"},
    {"id": "S3-REVIEW-BLOCK", "kind": "review_block"},
    {"id": "S3-INVALID-BLOCK", "kind": "invalid_block"},
    {"id": "S3-NONMATERIAL", "kind": "nonmaterial"},
    {"id": "S3-IDEMPOTENT", "kind": "idempotent"},
    {"id": "S3-MONOTONIC", "kind": "monotonic"},
    {"id": "S3-RULE-COVERAGE", "kind": "rule_coverage"},
    {"id": "S3-NO-PROVIDER-CALLS", "kind": "source_guard"}
  ]
}
