{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sef.local/schemas/expert-pack.v1.json",
  "title": "SEF Stable Expert Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "status",
    "purpose",
    "activate_when",
    "tool_requirements",
    "entry_points",
    "evidence_contract",
    "failure_recovery",
    "tags"
  ],
  "properties": {
    "schema": {"const": "sef.expert-pack.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["experimental", "candidate", "stable"]},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1200},
    "activate_when": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tool_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/toolRequirement"}
    },
    "entry_points": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/entryPoint"}
    },
    "evidence_contract": {"$ref": "#/$defs/evidenceContract"},
    "failure_recovery": {"$ref": "#/$defs/failureRecovery"},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "toolRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "access", "sensitivity", "required", "evidence"],
      "properties": {
        "capability": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "access": {"enum": ["READ", "WRITE"]},
        "sensitivity": {"enum": ["LOCAL", "SANDBOX", "PRODUCTION_SENSITIVE"]},
        "required": {"type": "boolean"},
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "purpose"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "kind": {"enum": ["SCRIPT", "EVALUATOR", "COLLECTOR", "ADAPTER"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 500},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "evidenceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "produces"],
      "properties": {
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "produces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "failureRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_modes", "recovery_actions", "stop_conditions"],
      "properties": {
        "failure_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "recovery_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
